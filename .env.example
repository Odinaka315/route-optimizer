# Copy this file to ".env" and fill it in. Never commit ".env" (it is in .gitignore).

ENVIRONMENT=development            # development | production

# --- Database (Neon) -------------------------------------------------------------
# Paste the strings exactly as Neon shows them; the app adapts them itself.
# App: the POOLED string (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-endpoint-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Migrations: Neon recommends the DIRECT string (same, without "-pooler").
ALEMBIC_DATABASE_URL=postgresql://USER:PASSWORD@ep-your-endpoint.REGION.aws.neon.tech/neondb?sslmode=require
# Only if you ever see "prepared statement ... does not exist" errors:
# DB_DISABLE_STATEMENT_CACHE=true

# --- Auth ------------------------------------------------------------------------------
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-one-at-least-32-characters
# Short-lived access token; the app swaps its refresh token for a new one via POST /auth/refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REQUIRE_EMAIL_VERIFICATION=true

# --- Email -----------------------------------------------------------------------------
# console = print the verification/reset links in the server log (development)
# smtp    = send for real through any provider that offers SMTP
EMAIL_BACKEND=console
EMAIL_FROM=Route Optimizer <no-reply@yourdomain.com>
# Where the links in emails point (your web/mobile app's address).
APP_BASE_URL=http://localhost:3000
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Browser apps only (comma-separated). Mobile apps don't need this.
CORS_ORIGINS=http://localhost:3000

# --- Routing engine ---------------------------------------------------------------------
# osrm = real road times/distances (needs an OSRM server)   haversine = rough offline estimate
MATRIX_BACKEND=osrm
# The public demo server is for development only. Self-host OSRM for real use.
OSRM_URL=https://router.project-osrm.org
SOLVER_TIME_LIMIT_S=10
MAX_STOPS=50
# inline = the API solves trips itself (simple). worker = the API only queues runs and
# `python -m app.worker` (a separate process, same .env) solves them.
RUN_MODE=inline
# Worker settings (only used by `python -m app.worker`):
# WORKER_POLL_INTERVAL_S=2
# RUN_LEASE_SECONDS=90
# RUN_MAX_ATTEMPTS=3
# RUN_RETRY_BACKOFF_S=10
# WORKER_SHUTDOWN_GRACE_S=30

# --- Address search ---------------------------------------------------------------------------
# nominatim = free, development only    mapbox = production (needs a token)
GEOCODER_PROVIDER=nominatim
GEOCODER_COUNTRY=ng
NOMINATIM_USER_AGENT=route-optimizer/0.2 (your-email@example.com)
# GEOCODER_PROVIDER=mapbox
# MAPBOX_ACCESS_TOKEN=pk.your-token
# Mapbox only allows storing results requested with permanent=true (billed differently,
# needs a card on file). Keep true unless you are sure results are never stored.
MAPBOX_PERMANENT=true
